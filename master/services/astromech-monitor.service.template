[Unit]
Description=AstromechOS Master Monitor (systemd watchdog)
After=astromech-master.service

[Service]
Type=simple
User=__USER__
# Restart astromech-master if it's been inactive for more than 10s.
ExecStart=/bin/bash -c '\
  while true; do \
    sleep 10; \
    if ! systemctl is-active --quiet astromech-master; then \
      echo "astromech-master inactive — restarting" | systemd-cat -t astromech-monitor; \
      systemctl start astromech-master; \
    fi; \
  done'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
