[Unit]
Description=Periodic retry for astromech pair-sealing while marker absent
Documentation=https://github.com/RickDnamps/AstromechOS/blob/main/docs/FIRSTBOOT.md
# Belt-and-suspenders next to astromech-pair-sealing.path (inotify watcher).
# Inotify events on /var/lib/NetworkManager/dnsmasq-wlan0.leases can be MISSED —
# slave joins during .path startup, dnsmasq writes the lease via atomic
# rename (no MODIFY event), or the file is created (no MODIFY before CREATE).
# This timer retries astromech-pair-sealing.service every 60s; the script
# (scripts/astromech_pair_sealing.sh:59) exits 0 immediately if the marker
# already exists, so timer ticks are cheap no-ops once paired.
#
# Bug fix 2026-06-08 (this PR): identified during birthday-edition validation
# cycle. After master + slave fresh flash from Golden Image, slave joined
# Astromech-7197 bootstrap correctly but .path inotify watcher missed the
# dnsmasq lease event. Manual `systemctl start astromech-pair-sealing.service`
# 15 min later worked instantly. UX risk: maker pulls power → SD corruption.
# This timer guarantees pair-sealing completes within 60s of slave joining.
After=NetworkManager.service
# Bug fix 2026-06-11: without this condition the timer activated on EVERY
# boot of an already-sealed robot and ticked the (condition-skipped) .service
# every 60s forever — one journal line per minute for the life of the robot.
# Timer-unit conditions are evaluated at timer ACTIVATION (boot), so a sealed
# robot never starts the timer at all. For the boot where sealing happens
# mid-session, astromech_pair_sealing.sh stops this timer right after writing
# the marker. Re-pair flow unchanged: rm the marker + systemctl start the
# .path and .timer (docs/FIRSTBOOT.md).
ConditionPathExists=!/var/lib/astromech/pair_sealed
# Never activate during the firstboot boot — its scheduled reboot kills a
# mid-flight sealing run between slave-push and AP-flip (field log
# 2026-06-12, see .service.template for the full autopsy).
ConditionPathExists=!/boot/ASTROMECH_FIRSTBOOT_READY
ConditionPathExists=!/boot/firmware/ASTROMECH_FIRSTBOOT_READY

[Timer]
OnBootSec=30sec
OnUnitInactiveSec=60sec
Unit=astromech-pair-sealing.service
RandomizedDelaySec=5sec

[Install]
WantedBy=timers.target
