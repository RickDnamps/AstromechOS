[Unit]
Description=AstromechOS first-boot provisioning (Imager bootstrap)
# Run after the network manager is up but BEFORE the master/slave services
# start (firstboot may swap origin + reboot before they should ever launch).
# Bug fix 2026-06-06 (commit will be in this PR): removed
# After=cloud-final.service. The cloud-init unit declares
# After=multi-user.target and astromech-firstboot is WantedBy=multi-user.target
# — adding After=cloud-final created a dependency cycle that systemd
# silently broke by dropping firstboot from the boot transaction
# (verified live via SD-USB autopsy: firstboot.log absent, trigger
# marker still present, NM profiles empty). The runcmd that this clause
# tried to order against is now baked as bootcmd in the Imager (runs
# at cloud-init-local uptime ~7s, before NetworkManager — no race).
After=network-online.target
Wants=network-online.target
# Bug fix 2026-06-12 (field: "no hotspot at all" on the 12-06 images):
# network-online.target does NOT guarantee NetworkManager is active when
# NetworkManager-wait-online is absent from the transaction — firstboot
# beat NM to the punch and setup_master_network.sh died on its NM check
# (the | tee pipeline then swallowed the failure; fixed with scoped
# pipefail + a _wait_for_nm loop in firstboot_setup.sh — this ordering
# is the third layer). After=NetworkManager.service creates NO cycle:
# NM is not ordered after multi-user.target (unlike cloud-final, see
# the 2026-06-06 note above).
Wants=NetworkManager.service
After=NetworkManager.service
Before=astromech-master.service astromech-slave.service
# Only fire when the Imager has placed the trigger marker. Two paths to
# cover Pi OS Bullseye (/boot) vs Bookworm+ (/boot/firmware).
ConditionPathExists=|/boot/ASTROMECH_FIRSTBOOT_READY
ConditionPathExists=|/boot/firmware/ASTROMECH_FIRSTBOOT_READY

[Service]
Type=oneshot
# Run as root — the script writes /etc/hostname, /var/log, touches
# /boot, and disables itself via systemctl.
User=root
WorkingDirectory=__REPO_PATH__
ExecStart=/bin/bash __REPO_PATH__/scripts/firstboot_setup.sh
# Allow the script to take its time on a slow SD card.
TimeoutStartSec=600
RemainAfterExit=yes
StandardOutput=journal+console
StandardError=journal+console
SyslogIdentifier=astromech-firstboot

[Install]
WantedBy=multi-user.target
