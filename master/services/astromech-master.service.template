[Unit]
Description=AstromechOS Master Controller
After=network.target
Wants=network.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO_PATH__
ExecStart=/usr/bin/python3 __REPO_PATH__/master/main.py
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=astromech-master

[Install]
WantedBy=multi-user.target
