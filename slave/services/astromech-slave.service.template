[Unit]
Description=AstromechOS Slave Controller
After=astromech-version.service
Wants=astromech-version.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO_PATH__
Environment=PYTHONPATH=__REPO_PATH__
Environment=XDG_RUNTIME_DIR=/run/user/__UID__
Environment=PULSE_RUNTIME_PATH=/run/user/__UID__/pulse
ExecStart=/usr/bin/python3 __REPO_PATH__/slave/main.py
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=astromech-slave

[Install]
WantedBy=multi-user.target
