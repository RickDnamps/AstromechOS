[Unit]
Description=AstromechOS Slave Version Check (run once at boot)
After=network.target
Before=astromech-slave.service

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__REPO_PATH__
# Version check is integrated in main.py; this unit is a placeholder
# for systemd dependency ordering.
ExecStart=/bin/true
RemainAfterExit=yes
StandardOutput=journal
SyslogIdentifier=astromech-version

[Install]
WantedBy=multi-user.target
